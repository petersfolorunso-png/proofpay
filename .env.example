# Copy to a file OUTSIDE the repo (default: ~/.secrets/aevum/wallet.env) or export these.
# Testnet-only keys. Never reuse a mainnet key.
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005
EXPLORER_URL=https://explorer-test.qday.info
TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
ESCROW_ADDRESS=
# Verifier agent key: can ONLY call agentRelease/agentReject (capped). Not the owner key.
AGENT_PRIVATE_KEY=
# Optional demo mode: server signs as a throwaway client + freelancer so judges can click through without a wallet.
DEMO_WALLETS=0
DEMO_CLIENT_PRIVATE_KEY=
DEMO_FREELANCER_PRIVATE_KEY=
DEMO_FREELANCER_X=
# AI judge: "gemini" or "none" (deterministic rules only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MIN_CONFIDENCE=0.75
ALLOW_RULES_ONLY_RELEASE=1
